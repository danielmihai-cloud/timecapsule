<mxfile host="app.diagrams.net">
  <diagram id="timecapsule-deploy" name="TimeCapsule deployment">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="880" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="&lt;b&gt;TimeCapsule — схема развёртывания&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="260" y="0" width="600" height="30" as="geometry"/>
        </mxCell>

        <!-- AWS Cloud -->
        <mxCell id="cloud" value="AWS Cloud" style="points=[];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=0;container=0;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_aws_cloud_alt;strokeColor=#232F3E;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#232F3E;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="260" y="40" width="1080" height="600" as="geometry"/>
        </mxCell>
        <!-- Region -->
        <mxCell id="region" value="Region: eu-central-1 (Frankfurt)" style="points=[];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=0;container=0;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_region;strokeColor=#00A4A6;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#147EBA;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="290" y="85" width="1020" height="530" as="geometry"/>
        </mxCell>
        <!-- VPC -->
        <mxCell id="vpc" value="Default VPC  vpc-06ab5a91d1deb838e  (172.31.0.0/16)" style="points=[];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=0;container=0;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_vpc2;strokeColor=#8C4FFF;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#AAB7B8;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="320" y="130" width="960" height="460" as="geometry"/>
        </mxCell>
        <!-- Availability Zone -->
        <mxCell id="az" value="Availability Zone: eu-central-1a" style="fillColor=none;strokeColor=#147EBA;dashed=1;verticalAlign=top;fontStyle=0;fontColor=#147EBA;whiteSpace=wrap;html=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="350" y="175" width="900" height="390" as="geometry"/>
        </mxCell>
        <!-- Public subnet -->
        <mxCell id="subnet" value="Public subnet (default)  subnet-08f354fce3ee0c2e6  (172.31.16.0/20)" style="points=[];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=0;container=0;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_security_group;grStroke=0;strokeColor=#7AA116;fillColor=#F2F6E8;verticalAlign=top;align=left;spacingLeft=30;fontColor=#248814;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="380" y="215" width="840" height="325" as="geometry"/>
        </mxCell>
        <!-- Security Group -->
        <mxCell id="sg" value="Security Group: webserver-sg (sg-068860a918f8a5a8f)&lt;br&gt;Inbound: HTTP 80 ← 0.0.0.0/0 · SSH 22 ← My IP" style="fillColor=none;strokeColor=#DD3522;dashed=0;verticalAlign=top;fontStyle=0;fontColor=#DD3522;whiteSpace=wrap;html=1;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="410" y="260" width="780" height="255" as="geometry"/>
        </mxCell>
        <!-- EC2 instance -->
        <mxCell id="ec2" value="EC2 instance «webserver» · t3.micro · Amazon Linux 2023&lt;br&gt;Public IP 3.70.134.155 · Private IP 172.31.25.185" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=0;container=0;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_ec2_instance_contents;strokeColor=#D86613;fillColor=#FFFFFF;verticalAlign=top;align=left;spacingLeft=30;fontColor=#D86613;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="440" y="315" width="720" height="175" as="geometry"/>
        </mxCell>

        <!-- Programs on EC2 -->
        <mxCell id="nginx" value="&lt;b&gt;nginx&lt;/b&gt;&lt;br&gt;порт 80&lt;br&gt;root /var/www/timecapsule/public" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDF1E6;strokeColor=#D86613;fontColor=#232F3E;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="465" y="380" width="190" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="php" value="&lt;b&gt;PHP-FPM 8.4&lt;/b&gt; (user apache)&lt;br&gt;TimeCapsule (Laravel)&lt;br&gt;/var/www/timecapsule" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDF1E6;strokeColor=#D86613;fontColor=#232F3E;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="725" y="380" width="190" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="pg" value="&lt;b&gt;PostgreSQL 16&lt;/b&gt;&lt;br&gt;база timecapsule&lt;br&gt;127.0.0.1:5432" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDF1E6;strokeColor=#D86613;fontColor=#232F3E;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="985" y="380" width="155" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="e_nginx_php" value="FastCGI&lt;br&gt;www.sock" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#545B64;fontSize=10;fontColor=#545B64;" edge="1" parent="1" source="nginx" target="php">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_php_pg" value="SQL&lt;br&gt;TCP 5432" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#545B64;fontSize=10;fontColor=#545B64;" edge="1" parent="1" source="php" target="pg">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Users -->
        <mxCell id="users" value="Посетители сайта&lt;br&gt;(браузер)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#232F3D;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.users;" vertex="1" parent="1">
          <mxGeometry x="60" y="381" width="78" height="78" as="geometry"/>
        </mxCell>
        <mxCell id="e_users" value="HTTP :80&lt;br&gt;http://3.70.134.155" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#232F3E;strokeWidth=2;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="users" target="nginx">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Developer computer -->
        <mxCell id="laptop" value="Мой компьютер (MacBook)&lt;br&gt;PhpStorm, git, ssh" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#232F3D;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.client;" vertex="1" parent="1">
          <mxGeometry x="60" y="690" width="78" height="76" as="geometry"/>
        </mxCell>

        <!-- GitHub (outside AWS) -->
        <mxCell id="github" value="&lt;b&gt;GitHub&lt;/b&gt;&lt;br&gt;danielmihai-cloud/timecapsule&lt;br&gt;(публичный репозиторий)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#232F3D;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.git_repository;" vertex="1" parent="1">
          <mxGeometry x="1420" y="364" width="78" height="78" as="geometry"/>
        </mxCell>

        <!-- Server pulls code from GitHub -->
        <mxCell id="e_pull" value="git pull по HTTPS :443&lt;br&gt;(только чтение)" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#7AA116;strokeWidth=2;fontSize=11;fontColor=#248814;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="ec2" target="github">
          <mxGeometry x="0.1" relative="1" as="geometry">
            <mxPoint y="-20" as="offset"/>
          </mxGeometry>
        </mxCell>
        <!-- git push -->
        <mxCell id="e_push" value="① git push (HTTPS)" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#147EBA;strokeWidth=2;fontSize=11;fontColor=#147EBA;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.7;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="laptop" target="github">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1550" y="743"/>
              <mxPoint x="1550" y="403"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <!-- deploy over SSH -->
        <mxCell id="e_ssh" value="② SSH :22&lt;br&gt;./deploy.sh" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#DD3522;strokeWidth=2;fontSize=11;fontColor=#DD3522;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.2;exitDx=0;exitDy=0;entryX=0.17;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="laptop" target="ec2">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="562" y="705"/>
            </Array>
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
