# ---------------------------------------------------------------
# TimeCapsule (Laravel) configuration.
# Copy this file to .env and run "php artisan key:generate".
# ---------------------------------------------------------------

APP_NAME=TimeCapsule
APP_ENV=local
APP_KEY=
# true = show error details (never on a public server)
APP_DEBUG=false
APP_URL=http://localhost:8080
# Used only by docker-compose.yml (host port of the app)
APP_PORT=8080

# Logs: "single" writes storage/logs/laravel.log, "stderr" is used in Docker
LOG_CHANNEL=single
LOG_LEVEL=debug

# PostgreSQL connection
# (Laravel names: DB_DATABASE = DB_NAME, DB_USERNAME = DB_USER in the other variants)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=timecapsule
DB_USERNAME=timecapsule
DB_PASSWORD=secret

# Sessions are stored as files in storage/framework/sessions (one server).
# With several servers behind a load balancer: SESSION_DRIVER=dynamodb and the table
# name below (cache store "dynamodb" in config/cache.php, credentials of the IAM role).
SESSION_DRIVER=file
SESSION_LIFETIME=120
DYNAMODB_CACHE_TABLE=timecapsule-dev-sessions
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

BCRYPT_ROUNDS=12

# --- TimeCapsule settings (see config/timecapsule.php) ---
# false = no login, everyone is "Guest"
AUTH_ENABLED=true
# Fake "email sending" delay when a capsule is created
MAIL_DELAY_SECONDS=3
# Where uploads are saved. Empty = storage/app/uploads
UPLOAD_DIR=
# Maximum attachment size in MB
MAX_UPLOAD_MB=5

# --- Attachments in Amazon S3 (see config/filesystems.php, disk "s3") ---
# Bucket for attachments (objects under the uploads/ prefix) and its region.
# No AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY here: on the server the AWS SDK
# gets temporary credentials of the instance's IAM role.
S3_BUCKET=timecapsule-dev-uploads-danielmihai
AWS_REGION=eu-central-1
